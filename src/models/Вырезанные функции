        dropout_p = trail.suggest_float('dropout_p', 0, 1)

        model = CNN(num_classes=num_classes, n_filters=n_filters, hidden_size=hidden_size, dropout_p=dropout_p).to(self.device)
        optim = torch.optim.Adam(params=model.parameters(), lr=lr, weight_decay=0.01)
        loss_fn = nn.CrossEntropyLoss()

        train_loader = DataLoader(train_data, batch_size=batch_size, shuffle=True)
        val_loader = DataLoader(val_data, batch_size=batch_size, shuffle=False)
        loss = old_train_funcs.train_objective(
                                train_loader=train_loader,
                                val_loader=val_loader,
                                model = model,
                                optim = optim,
                                loss_fn = loss_fn,
                                epochs=epochs,
                                device = self.device
                                )
        return loss
    def transfer_train(self, params, epochs, last_data, train_data, val_data, freeze_param, num_classes, model_name = 'best_model.pth'):
        #freeze_param: int -->  0 - ничего не замораживать, обучение по новой
                               #1 - НЕ замораживаем последний слой, остальное замораживаем
                               #2 - заморозили всю свертку
                               #3 - замораживаем только первый сверточный слой
                 
        model = CNN(num_classes=params['num_classes'], 
                    n_filters = params['n_filters'], 
                    dropout_p=params['dropout_p'], 
                    hidden_size=params['hidden_size']).to(params['device'])
        model.load_state_dict(model_name)

        if freeze_param == 1:
            model.fc2 = nn.Linear(params['hidden_size'], num_classes).to(params['device'])
            #заморозили все слои
            for param in model.parameters():
                param.requires_grad = False

            #разморозили последний
            for param in model.fc2.parameters():
                param.requires_grad = True

            #переводим ВСЕ BN в Eval для того, чтобы не искажал данные
            for name, module in model.named_modules():
                if isinstance(module, torch.nn.BatchNorm2d):
                    print(f'Eval OK {module}')
                    module.eval()
            
        if freeze_param == 2:
            model.fc2 = nn.Linear(params['hidden_size'], num_classes)
            #заморозили все слои
            for param in model.parameters():
                param.requires_grad = False

            #разморозили fc1, fc2
            for param in model.fc2.parameters():
                param.requires_grad = True
            for param in model.fc1.parameters():
                param.requires_grad = True

            #переводим ВСЕ BN в Eval для того, чтобы не искажал данные
            for name, module in model.named_modules():
                if isinstance(module, torch.nn.BatchNorm2d):
                    print(f'Eval OK {module}')
                    module.eval()

        if freeze_param == 3:
            model.fc2 = nn.Linear(params['hidden_size'], num_classes)
            #загрузили веса
            model.load_state_dict(model_name)
            
            #заморозили все слои
            for param in model.parameters():
                param.requires_grad = False

            #разморозили fc1, fc2
            for param in model.fc2.parameters():
                param.requires_grad = True
            for param in model.fc1.parameters():
                param.requires_grad = True

            #разморозили последнюю свертку
            for param in model.layer2.parameters():
                param.requires_grad = True

            #переводим ПЕРВЫЙ BN в Eval для того, чтобы не искажал данные
            for name, module in model.batchnorm1.named_modules():
                if isinstance(module, torch.nn.BatchNorm2d):
                    print(f'Eval OK {module}')
                    module.eval()
        else:
            model = CNN(num_classes=num_classes, 
                    n_filters = params['n_filters'], 
                    dropout_p=params['dropout_p'], 
                    hidden_size=params['hidden_size']).to(params['device'])

        concat_data = ConcatDataset([train_data, last_data])
        concat_sampler = solve_imbalance(concat_data)
        concat_loader = DataLoader(concat_data, sampler = concat_sampler, batch_size=params['batch_size'])
        val_loader = DataLoader(val_data, batch_size=params['batch_size'], shuffle=True)
        params['lr'] = params['lr'] * 0.5
        f1_best = old_train_funcs.train_final(train_data=concat_data,
                            val_data = val_data,
                            train_loader=concat_loader,
                            val_loader=val_loader,
                            model = model,
                            params = params,
                            epochs=epochs,
                            )
        return f1_best

